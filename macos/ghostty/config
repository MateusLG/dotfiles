# Ghostty no macOS. Variante do ghostty/config (Omarchy/Linux).
# Diferenças: tema local em vez do symlink do Omarchy, fonte maior (Retina),
# sem opções de GTK/epoll (Linux-only) e keybinds sem a tecla Insert.

# Tema — o Omarchy trocava via ~/.config/omarchy/current/theme/ghostty.conf,
# que não existe aqui. Portado para themes/lg-abissal.
theme = lg-abissal

# Font — 9pt era pra tela Linux; em Retina fica ilegível.
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 14

# Window
window-padding-x = 14
window-padding-y = 14
# 0.5 dependia do blur do Hyprland; no macOS o blur é do próprio Ghostty.
background-opacity = 0.92
background-blur = true
confirm-close-surface = false
resize-overlay = never
macos-titlebar-style = tabs

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Deixa a Option funcionar como Alt (senão os atalhos de shell com Meta
# não chegam no zsh).
macos-option-as-alt = true

# Keyboard bindings
# NOTA: os binds de shift+insert / control+insert do Linux saíram — teclado
# Mac não tem Insert, e cmd+c / cmd+v já vêm por padrão.
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
