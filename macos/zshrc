alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias eff='$EDITOR "$(ff)"'

sff() {
  if [ $# -eq 0 ]; then echo "Usage: sff <destination> (e.g. sff host:/tmp/)"; return 1; fi
  local file
  # Glob do zsh: (.) só arquivos comuns, (om) ordenado por mtime desc.
  # Substitui o `find -printf` do GNU, que o find BSD do macOS não tem.
  file=$(print -rl -- **/*(.omN) | ff) && [ -n "$file" ] && scp "$file" "$1"
}

if command -v zoxide &>/dev/null; then
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi
      printf "\U000F17A9 "
      pwd
    fi
  }
fi

