[Unit]
Description=ITSM homologacao - fila e reconciliacao RDM
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=mateus
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /home/mateus/infra/dotfiles/vps/bin/itsm-rdm-job.py
TimeoutStartSec=280
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
